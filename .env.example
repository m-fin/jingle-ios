# Copy to .env.local for this machine. .env and .env.local are gitignored.
# Nothing in this file is a secret. Leave values empty until you have them.

# Public https page for the privacy policy. Settings opens this only when it
# is a real https URL. The in-app policy works with this left blank.
# After the repo is public, this page is a valid App Store Connect URL:
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://github.com/m-fin/jingle-ios/blob/main/PRIVACY.md
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# Do not commit real values for any of the names below.
# Put them in your shell, in .env.local, or in EAS environment variables.
# EXPO_TOKEN=
# APPLE_ID=
# ASC_APP_ID=
# APP_STORE_CONNECT_API_KEY_ID=
# APP_STORE_CONNECT_API_ISSUER_ID=
# APP_STORE_CONNECT_API_KEY_PATH=
